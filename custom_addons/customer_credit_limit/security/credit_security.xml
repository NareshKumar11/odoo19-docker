<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19: groups are grouped under a privilege, not a module category. -->
    <record id="res_groups_privilege_credit" model="res.groups.privilege">
        <field name="name">Customer Credit</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_credit_approver" model="res.groups">
        <field name="name">Credit Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_credit"/>
    </record>

    <!-- Accounting managers are credit approvers, so nobody is locked out of
         editing a credit limit on a fresh install. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('customer_credit_limit.group_credit_approver'))]"/>
    </record>

    <record id="credit_approval_company_rule" model="ir.rule">
        <field name="name">Credit Approval: multi-company</field>
        <field name="model_id" ref="model_customer_credit_approval"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="credit_log_company_rule" model="ir.rule">
        <field name="name">Credit Limit History: multi-company</field>
        <field name="model_id" ref="model_customer_credit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
