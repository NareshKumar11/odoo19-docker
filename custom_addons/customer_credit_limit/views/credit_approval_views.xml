<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Small dialog the salesperson fills in from the order -->
    <record id="customer_credit_approval_request_form" model="ir.ui.view">
        <field name="name">customer.credit.approval.request.form</field>
        <field name="model">customer.credit.approval</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Request Credit Approval">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="credit_limit"/>
                            <field name="outstanding"/>
                            <field name="order_amount"/>
                            <field name="exceeded_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Why should this order be released?"/>
                        <field name="expected_payment_date"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object" string="Send for Approval"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Full form the approver works in -->
    <record id="customer_credit_approval_view_form" model="ir.ui.view">
        <field name="name">customer.credit.approval.form</field>
        <field name="model">customer.credit.approval</field>
        <field name="arch" type="xml">
            <form string="Credit Approval">
                <header>
                    <button name="action_submit" type="object" string="Send for Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve_order" type="object"
                            string="Approve This Order" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="customer_credit_limit.group_credit_approver"/>
                    <button name="action_approve_temporary" type="object"
                            string="Approve With Temporary Limit" class="btn-primary"
                            invisible="state != 'to_approve'"
                            groups="customer_credit_limit.group_credit_approver"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'to_approve'"
                            groups="customer_credit_limit.group_credit_approver"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'to_approve')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"
                                   invisible="not sale_order_id"/>
                            <field name="block_reason" readonly="1"/>
                            <field name="request_user_id" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="expected_payment_date"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Position When Requested">
                            <field name="credit_limit" readonly="1"/>
                            <field name="outstanding" readonly="1"/>
                            <field name="order_amount" readonly="1"/>
                            <field name="exceeded_amount" readonly="1"/>
                            <field name="used_percent" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state not in ('draft', 'to_approve')"/>
                    </group>
                    <group string="Temporary Limit"
                           invisible="state not in ('to_approve', 'approved', 'expired')">
                        <field name="temporary_amount"
                               readonly="state != 'to_approve'"/>
                        <field name="temporary_expiry"
                               readonly="state != 'to_approve'"/>
                    </group>
                    <group string="Decision" invisible="state in ('draft', 'to_approve')">
                        <field name="decision" readonly="1"/>
                        <field name="approver_id" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                        <field name="decision_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="customer_credit_approval_view_list" model="ir.ui.view">
        <field name="name">customer.credit.approval.list</field>
        <field name="model">customer.credit.approval</field>
        <field name="arch" type="xml">
            <list string="Credit Approvals" create="false"
                  decoration-danger="state == 'to_approve'"
                  decoration-muted="state in ('rejected', 'cancelled', 'expired')">
                <field name="name"/>
                <field name="request_date"/>
                <field name="partner_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="order_amount" optional="hide"/>
                <field name="exceeded_amount" sum="Exceeded"/>
                <field name="block_reason" optional="hide"/>
                <field name="request_user_id" optional="hide"/>
                <field name="decision" optional="show"/>
                <field name="temporary_expiry" optional="show"/>
                <field name="approver_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'to_approve'"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="customer_credit_approval_view_search" model="ir.ui.view">
        <field name="name">customer.credit.approval.search</field>
        <field name="model">customer.credit.approval</field>
        <field name="arch" type="xml">
            <search string="Credit Approvals">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="temporary_active" string="Temporary Limit Active"
                        domain="[('state', '=', 'approved'), ('decision', '=', 'temporary'),
                                 ('temporary_expiry', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="my_requests" string="My Requests"
                        domain="[('request_user_id', '=', uid)]"/>
                <separator/>
                <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_credit_approval" model="ir.actions.act_window">
        <field name="name">Credit Approvals</field>
        <field name="res_model">customer.credit.approval</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="customer_credit_approval_view_search"/>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for approval</p>
            <p>Requests appear here when a salesperson asks for an order over the
               credit limit to be released.</p>
        </field>
    </record>

</odoo>
